# ============================================
# SaaSForge - Variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs
# ============================================

# === SUPABASE (OBLIGATOIRE) ===
# Va sur https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (pour les webhooks et opérations admin)
# Va dans Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# === GROQ IA (RECOMMANDÉ - Gratuit) ===
# Va sur https://console.groq.com/keys
GROQ_API_KEY=

# === STRIPE (OPTIONNEL mais puissant) ===
# Va sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook secret (après avoir configuré le webhook)
# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# === PRIX STRIPE (OPTIONNEL) ===
# Crée des produits dans Stripe Dashboard → Products
# Copie les Price IDs (commencent par price_)
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=

# === APPLICATION ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
